        },
        {
          "language": "jsonld",
          "url": "https://ogcincubator.github.io/bblocks-examples-devel/build/tests/bbr/examples/feature/overrideContext/example_1_1.jsonld",
          "sizeBytes": 459,
          "code": "{\n  \"@context\": \"https://ogcincubator.github.io/bblocks-examples-devel/build/annotated/bbr/examples/feature/overrideContext/context.jsonld\",\n  \"id\": \"f1\",\n  \"type\": \"Feature\",\n  \"geometry\": {\n    \"type\": \"Point\",\n    \"coordinates\": [\n      59.354444,\n      17.939722\n    ]\n  },\n  \"properties\": {\n    \"id\": \"urn:ngsi-ld:AirportFacility:id:IUXP:30337114\",\n    \"type\": \"AirportFacility\",\n    \"IataCode\": \"BMA\",\n    \"IcaoCode\": \"ESSB\",\n    \"Name\": \"control\"\n  }\n}"
        },
        {
          "language": "ttl",
          "url": "https://ogcincubator.github.io/bblocks-examples-devel/build/tests/bbr/examples/feature/overrideContext/example_1_1.ttl",
          "sizeBytes": 552,
          "code": "@prefix geojson: <https://purl.org/geojson/vocab#> .\n@prefix ns1: <https://smartdatamodels.org/dataModel.ACRIS/> .\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n\n<http://example.com/features/f1> a geojson:Feature,\n        ns1:AirportFacility ;\n    rdfs:label \"control\" ;\n    geojson:geometry [ a geojson:Point ;\n            geojson:coordinates ( 5.935444e+01 1.793972e+01 ) ] ;\n    ns1:IataCode \"BMA\" ;\n    ns1:IcaoCode \"ESSB\" .\n\n"
        }
      ]
