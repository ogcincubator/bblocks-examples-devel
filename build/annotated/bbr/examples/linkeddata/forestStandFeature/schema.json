{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Example of a simple GeoJSON Feature specialisation",
  "$defs": {
    "MyFeature": {
      "allOf": [
        {
          "$ref": "https://opengeospatial.github.io/bblocks/annotated-schemas/geo/features/feature/schema.json"
        },
        {
          "properties": {
            "properties": {
              "$ref": "https://ogcincubator.github.io/bblocks-examples-devel/build/annotated/bbr/examples/linkeddata/forestStandProperties/schema.json"
            }
          }
        }
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/MyFeature"
    }
  ],
  "x-bblocks-metadata": {
    "itemIdentifier": "ogc.bbr.examples.linkeddata.forestStandFeature",
    "register": "https://ogcincubator.github.io/bblocks-examples-devel/build/register.json",
    "version": "1.0",
    "dateOfLastChange": "2026-11-09"
  }
}