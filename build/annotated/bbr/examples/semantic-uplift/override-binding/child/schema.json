{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Profile of \"Override Binding - Base\" that redeclares \"note\" and \"label\" to narrow their inherited SKOS bindings.",
  "allOf": [
    {
      "$ref": "https://ogcincubator.github.io/bblocks-examples/build/annotated/bbr/examples/semantic-uplift/override-binding/base/schema.json"
    },
    {
      "type": "object",
      "properties": {
        "note": {
          "type": "string",
          "x-jsonld-id": "http://www.w3.org/2004/02/skos/core#definition"
        },
        "label": {
          "type": "string",
          "x-jsonld-id": "http://www.w3.org/2004/02/skos/core#altLabel",
          "x-jsonld-type": "http://www.w3.org/2001/XMLSchema#language"
        }
      }
    }
  ]
}